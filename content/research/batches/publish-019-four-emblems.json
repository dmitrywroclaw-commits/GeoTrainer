  "entries": [
    {
      "id": "cyprus-national-emblem", "kind": "emblem", "countryId": "cyprus", "nameRu": "Кипр",
      "subtitleRu": "Государственная эмблема", "symbolType": "national_emblem", "mediaId": "emblem-cyprus",
      "summaryRu": "На медном щите изображён белый голубь с оливковой ветвью. Под голубем стоит год «1960», а щит окружают две оливковые ветви.",
      "explanationRu": "Министерство иностранных дел Кипра связывает медный цвет с историей острова; голубь и оливковые ветви обозначают мир. Число 1960 указывает на год независимости.",
      "historyRu": "Эмблема относится к символам Республики Кипр, независимой с 1960 года.",
      "symbols": [
        { "nameRu": "Белый голубь и оливковые ветви", "category": "animal", "meaningStatus": "official", "meaningRu": "Символизируют мир.", "sourceIds": ["cy-government-emblem"] },
        { "nameRu": "Медный цвет щита", "category": "shield", "meaningStatus": "official", "meaningRu": "Связан с древней историей добычи меди на Кипре.", "sourceIds": ["cy-government-emblem"] },
        { "nameRu": "Число 1960", "category": "inscription", "meaningStatus": "official", "meaningRu": "Год независимости Республики Кипр.", "sourceIds": ["cy-government-emblem"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Государственная эмблема" }, { "labelRu": "Число на щите", "valueRu": "1960" }],
      "sourceIds": ["cy-government-emblem"], "quizHints": { "similarityTags": ["animal", "plant", "shield"] },
      "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "czechia-greater-coat-of-arms", "kind": "emblem", "countryId": "czechia", "nameRu": "Чехия",
      "subtitleRu": "Большой государственный герб", "symbolType": "coat_of_arms", "mediaId": "emblem-czechia",
      "summaryRu": "Щит разделён на четыре поля: в двух красных полях — серебряный двухвостый лев, в синем — красно-белая шахматная орлица, в золотом — чёрная орлица.",
      "explanationRu": "МВД Чехии различает большой и малый государственные гербы. Большой герб объединяет знаки Чехии, Моравии и Силезии; два поля со львом повторяют знак Чехии.",
      "historyRu": "Действующий состав большого герба определён законом о государственных символах Чехии.",
      "symbols": [
        { "nameRu": "Двухвостый лев", "category": "animal", "meaningStatus": "official", "meaningRu": "Геральдический знак Чехии.", "sourceIds": ["cz-foreign-ministry-historical-lands"] },
        { "nameRu": "Красно-белая орлица", "category": "animal", "meaningStatus": "official", "meaningRu": "Геральдический знак Моравии.", "sourceIds": ["cz-foreign-ministry-historical-lands"] },
        { "nameRu": "Чёрная орлица", "category": "animal", "meaningStatus": "official", "meaningRu": "Геральдический знак Силезии.", "sourceIds": ["cz-foreign-ministry-historical-lands"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Большой государственный герб" }, { "labelRu": "Поля щита", "valueRu": "4" }],
      "sourceIds": ["cz-interior-coats-of-arms", "cz-foreign-ministry-historical-lands"], "quizHints": { "similarityTags": ["animal", "shield", "eagle"] },
      "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "denmark-national-coat-of-arms", "kind": "emblem", "countryId": "denmark", "nameRu": "Дания",
      "subtitleRu": "Государственный герб", "symbolType": "coat_of_arms", "mediaId": "emblem-denmark",
      "summaryRu": "На золотом щите изображены три синих коронованных льва среди девяти красных сердцевидных фигур. Над щитом находится королевская корона.",
      "explanationRu": "МИД Дании отличает этот государственный герб от большого королевского герба. Три льва среди красных фигур — исторический знак датских королей со времён Вальдемаров.",
      "historyRu": "Государственный герб с тремя львами известен со времён династии Вальдемаров.",
      "symbols": [
        { "nameRu": "Три коронованных льва", "category": "animal", "meaningStatus": "unknown", "sourceIds": ["dk-foreign-ministry-coats-of-arms"] },
        { "nameRu": "Девять красных фигур", "category": "other", "meaningStatus": "unknown", "sourceIds": ["dk-foreign-ministry-coats-of-arms"] },
        { "nameRu": "Корона", "category": "crown", "meaningStatus": "unknown", "sourceIds": ["dk-foreign-ministry-coats-of-arms"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Государственный герб" }, { "labelRu": "Львы", "valueRu": "3" }, { "labelRu": "Красные фигуры", "valueRu": "9" }],
      "sourceIds": ["dk-foreign-ministry-coats-of-arms"], "quizHints": { "similarityTags": ["animal", "crown", "shield"] },
      "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "estonia-greater-coat-of-arms", "kind": "emblem", "countryId": "estonia", "nameRu": "Эстония",
      "subtitleRu": "Большой государственный герб", "symbolType": "coat_of_arms", "mediaId": "emblem-estonia",
      "summaryRu": "На золотом щите помещены три синих льва. Щит с боков и снизу обрамляют две золотые дубовые ветви, скрещённые внизу.",
      "explanationRu": "Закон Эстонии предусматривает большой и малый гербы. У малого тот же щит с тремя львами, но без дубовых ветвей.",
      "historyRu": "Герб с тремя львами был принят парламентом Эстонии 19 июня 1925 года.",
      "symbols": [
        { "nameRu": "Три синих льва", "category": "animal", "meaningStatus": "unknown", "sourceIds": ["ee-national-coat-of-arms-act"] },
        { "nameRu": "Дубовые ветви", "category": "plant", "meaningStatus": "unknown", "sourceIds": ["ee-national-coat-of-arms-act"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Большой государственный герб" }, { "labelRu": "Львы", "valueRu": "3" }, { "labelRu": "Принят", "valueRu": "19 июня 1925 года" }],
      "sourceIds": ["ee-national-coat-of-arms-act"], "quizHints": { "similarityTags": ["animal", "plant", "shield"] },
      "status": "published", "verifiedAt": "2026-10-21"
    }
  ],
