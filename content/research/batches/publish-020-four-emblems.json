    {
      "id": "finland-coat-of-arms", "kind": "emblem", "countryId": "finland", "nameRu": "Финляндия", "subtitleRu": "Государственный герб", "symbolType": "coat_of_arms", "mediaId": "emblem-finland",
      "summaryRu": "На красном щите — золотой коронованный лев. Вместо правой передней лапы у него рука в доспехе с поднятым мечом; задними лапами лев попирает саблю. Вокруг — девять серебряных роз.",
      "explanationRu": "Такой состав герба прямо установлен законом Финляндии № 381/1978. Закон описывает рисунок, но не устанавливает значение отдельных деталей.",
      "historyRu": "Закон о гербе принят 26 мая 1978 года и вступил в силу 1 июня того же года.",
      "symbols": [
        { "nameRu": "Коронованный лев", "category": "animal", "meaningStatus": "unknown", "sourceIds": ["fi-coat-of-arms-act-1978"] },
        { "nameRu": "Меч и сабля", "category": "other", "meaningStatus": "unknown", "sourceIds": ["fi-coat-of-arms-act-1978"] },
        { "nameRu": "Девять роз", "category": "flower", "meaningStatus": "unknown", "sourceIds": ["fi-coat-of-arms-act-1978"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Герб" }, { "labelRu": "Розы", "valueRu": "9" }, { "labelRu": "Закон", "valueRu": "№ 381/1978" }],
      "sourceIds": ["fi-coat-of-arms-act-1978"], "quizHints": { "similarityTags": ["animal", "flower", "shield"] }, "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "greece-national-emblem", "kind": "emblem", "countryId": "greece", "nameRu": "Греция", "subtitleRu": "Государственная эмблема", "symbolType": "national_emblem", "mediaId": "emblem-greece",
      "summaryRu": "На синем щите изображён белый крест. Щит окружён двумя лавровыми ветвями.",
      "explanationRu": "Президентский сайт описывает именно эту композицию современной эмблемы. Синий и белый цвета присутствовали в первых национальных символах, утверждённых в 1822 году.",
      "historyRu": "Современный вид связан с учреждением Третьей Греческой республики в 1974 году.",
      "symbols": [
        { "nameRu": "Белый крест на синем щите", "category": "cross", "meaningStatus": "unknown", "sourceIds": ["gr-presidency-national-emblem"] },
        { "nameRu": "Лавровые ветви", "category": "plant", "meaningStatus": "unknown", "sourceIds": ["gr-presidency-national-emblem"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Национальная эмблема" }, { "labelRu": "Основные цвета", "valueRu": "Синий и белый" }],
      "sourceIds": ["gr-presidency-national-emblem"], "quizHints": { "similarityTags": ["cross", "plant", "shield"] }, "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "ireland-coat-of-arms", "kind": "emblem", "countryId": "ireland", "nameRu": "Ирландия", "subtitleRu": "Государственный герб", "symbolType": "coat_of_arms", "mediaId": "emblem-ireland",
      "summaryRu": "На синем поле изображена золотая арфа с серебряными струнами.",
      "explanationRu": "Ирландское ведомство называет арфу государственным гербом и эмблемой. Образцом для современного рисунка послужила арфа XIV века, известная как арфа Брайана Бору и хранящаяся в Тринити-колледже Дублина.",
      "historyRu": "Арфа засвидетельствована как герб Ирландии уже в средневековых гербовниках около 1270 года.",
      "symbols": [{ "nameRu": "Золотая арфа", "category": "other", "meaningStatus": "official", "meaningRu": "Государственная эмблема Ирландии.", "sourceIds": ["ie-enterprise-state-emblems"] }],
      "facts": [{ "labelRu": "Тип", "valueRu": "Герб" }, { "labelRu": "Поле", "valueRu": "Синее" }, { "labelRu": "Струны", "valueRu": "Серебряные" }],
      "sourceIds": ["ie-enterprise-state-emblems"], "quizHints": { "similarityTags": ["harp", "shield"] }, "status": "published", "verifiedAt": "2026-10-21"
    },
    {
      "id": "italy-national-emblem", "kind": "emblem", "countryId": "italy", "nameRu": "Италия", "subtitleRu": "Эмблема Итальянской Республики", "symbolType": "national_emblem", "mediaId": "emblem-italy",
      "summaryRu": "В центре эмблемы — белая пятиконечная звезда на зубчатом колесе. Композицию окружают оливковая и дубовая ветви; внизу находится красная лента с названием страны.",
      "explanationRu": "Президентский сайт объясняет оливу как знак стремления к миру, дуб — силы и достоинства народа, зубчатое колесо — труда. Звезда издавна связана с образом Италии.",
      "historyRu": "Эмблему по проекту Паоло Паскетто утвердили 5 мая 1948 года после двух открытых конкурсов.",
      "symbols": [
        { "nameRu": "Звезда", "category": "star", "meaningStatus": "official", "meaningRu": "Исторически связана с олицетворением Италии.", "sourceIds": ["it-presidency-emblem"] },
        { "nameRu": "Зубчатое колесо", "category": "other", "meaningStatus": "official", "meaningRu": "Символизирует труд.", "sourceIds": ["it-presidency-emblem"] },
        { "nameRu": "Оливковая ветвь", "category": "plant", "meaningStatus": "official", "meaningRu": "Символизирует стремление к миру.", "sourceIds": ["it-presidency-emblem"] },
        { "nameRu": "Дубовая ветвь", "category": "plant", "meaningStatus": "official", "meaningRu": "Олицетворяет силу и достоинство народа.", "sourceIds": ["it-presidency-emblem"] }
      ],
      "facts": [{ "labelRu": "Тип", "valueRu": "Национальная эмблема" }, { "labelRu": "Автор проекта", "valueRu": "Паоло Паскетто" }, { "labelRu": "Утверждена", "valueRu": "5 мая 1948 года" }],
      "sourceIds": ["it-presidency-emblem"], "quizHints": { "similarityTags": ["star", "plant", "gear"] }, "status": "published", "verifiedAt": "2026-10-21"
    }
